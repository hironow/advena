{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_generated.py\""
          }
        ]
      }
    ]
  }
}
